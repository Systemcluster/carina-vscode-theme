    // MARK: Token Colors
    "tokenColors": [
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.operator.expression",
                "storage.modifier",
                "storage.type",
            ],
            "settings": {
                "foreground": "#e15f7be8"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.logical",
                "keyword.operator.type",
                "keyword.operator.assignment",
            ],
            "settings": {
                "foreground": "#ff8787"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
            ],
            "settings": {
                "foreground": "#87878a"
            }
        },
        {
            "name": "Literals",
            "scope": [
                "string",
                "constant",
            ],
            "settings": {
                "foreground": "#83a554",
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "support.type.builtin",
            ],
            "settings": {
                "foreground": "#f17ebf",
            }
        },
        {
            "name": "Comment",
            "scope": [
                "comment",
                "comment.block.documentation",
            ],
            "settings": {
                "foreground": "#97979a"
            }
        },
        {
            "name": "Namespace",
            "scope": [
                "entity.name.namespace",
            ],
            "settings": {
                "foreground": "#787878"
            }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.namespace",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#cca029"
            }
        },
        {
            "name": "Function",
            "scope": [
                "meta.function",
                "meta.function-call",
                "entity.name.function",
                "support.function",
                "support.class.component",
            ],
            "settings": {
                "foreground": "#3b96e5"
            }
        },
        {
            "name": "Lifetime",
            "scope": [
                "entity.name.type.lifetime",
                "storage.modifier.lifetime",
            ],
            "settings": {
                // #c286d8
                "foreground": "#9f70b0",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Attribute",
            "scope": [
                "entity.other.attribute-name",
                "meta.attribute",
                "meta.tag.attribute",
                "meta.object-literal",
                "punctuation.definition.annotation",
                "punctuation.definition.attribute",
            ],
            "settings": {
                "foreground": "#506794"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "entity.name.variable",
                "support.variable",
                "support.other.variable",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#6a5a5d"
            }
        },
        {
            "name": "Constant Variable",
            "scope": [
                "variable.constant",
                "variable.other.constant",
            ],
            "settings": {
                "foreground": "#6a5a5db8",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Links",
            "scope": [
                "string.other.link",
            ],
            "settings": {
                "foreground": "#ff8787",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Escapes",
            "scope": [
                "constant.character.escape",
                "constant.character.escaped",
            ],
            "settings": {
                "foreground": "#ff8787",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Properties",
            "scope": [
                "support.type.property-name",
                "support.type.vendored.property-name",
                "variable.other.property",
                "variable.other.object.property"
            ],
            "settings": {
                "foreground": "#506794"
            }
        },
        {
            "name": "Tables",
            "scope": [
                "support.type.property-name.table",
                "support.type.property-name.array",
            ],
            "settings": {
                "foreground": "#3b96e5"
            }
        },
        {
            "name": "Entity Name",
            "scope": [
                "entity.name",
            ],
            "settings": {
                "foreground": "#ff8787"
            }
        },
        {
            "name": "CSS: Pseudo Class",
            "scope": [
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css",
            ],
            "settings": {
                "foreground": "#3b96e5",
                "fontStyle": "italic"
            }
        },
        {
            "name": "CSS: Attribute Name",
            "scope": [
                "entity.other.attribute-name.css",
            ],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "name": "CSS: Property Value",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css",
            ],
            "settings": {
                "foreground": "#83a554",
            }
        },
        // MARK: Markup
        {
            "name": "Markup: Headings",
            "scope": [
                "markup.heading",
            ],
            "settings": {
                "foreground": "#3b96e5",
                "fontStyle": "bold"
            }
