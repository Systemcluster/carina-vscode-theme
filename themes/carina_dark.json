    // MARK: Semantic Colors
    "semanticTokenColors": {
        "keyword": {
            "foreground": "#ff8787d8"
        },
        "keyword.unsafe": {
            "bold": true
        },
        "namespace": {
            "foreground": "#ffffffa8"
        },
        "struct": {
            "foreground": "#f4d893d8"
        },
        "interface": {
            "foreground": "#bcd59a"
        },
        "enum": {
            "foreground": "#f4d893d8"
        },
        "enumMember": {
            "foreground": "#c2e5fbb8"
        },
        "typeAlias": {
            "foreground": "#f4d893d8"
        },
        "builtinType": {
            "foreground": "#f4d893d8"
        },
        "typeParameter": {
            "foreground": "#f4d893d8",
            "bold": true
        },
        "function": {
            "foreground": "#6b9ee9"
        },
        "method": {
            "foreground": "#6b9ee9"
        },
        "variable": {
            "foreground": "#ffffffa8"
        },
        "variable.callable": {
            "foreground": "#6b9ee9"
        },
        "parameter": {
            "foreground": "#ffffffa8"
        },
        "selfKeyword": {
            "foreground": "#ffffffa8"
        },
        "selfTypeKeyword": {
            "foreground": "#f4d893d8"
        },
        "property": {
            "foreground": "#91b1e0"
        },
        "macro": {
            "foreground": "#6b9ee9"
        },
        "macroBang": {
            "foreground": "#ff8787e8",
            "bold": true
        },
        "string": {
            "foreground": "#93ab62",
            "bold": true
        },
        "stringLiteral": {
            "foreground": "#93ab62",
            "bold": true
        },
        "character": {
            "foreground": "#93ab62",
            "bold": true
        },
        "characterLiteral": {
            "foreground": "#93ab62",
            "bold": true
        },
        "escapeSequence": {
            "foreground": "#ff8787e8",
            "bold": true
        },
        "lifetime": {
            "foreground": "#d296e8",
            "italic": true
        },
        "operator": {
            "foreground": "#ffffff88"
        },
        "operator.controlFlow": {
            "foreground": "#ff8787e8"
        },
        "operator.mutable": {
            "foreground": "#ff8787e8"
        },
        "comparison": {
            "foreground": "#ff8787e8"
        },
        "logical": {
            "foreground": "#ff8787e8"
        },
        "angle": {
            "foreground": "#ffffff88"
        },
        "punctuation": {
            "foreground": "#ffffff88"
        },
        "number": {
            "foreground": "#d296e8",
            "bold": true
        },
        "numberLiteral": {
            "foreground": "#d296e8",
            "bold": true
        },
        "formatSpecifier": {
            "foreground": "#f17ebf"
        },
        "comment": {
            "foreground": "#ffffff88"
        },
        "variable.reference": {
            "italic": true
        },
        "parameter.reference": {
            "italic": true
        },
        "selfKeyword.reference": {
            "italic": true
        },
        "selfParameter.reference": {
            "italic": true
        },
        "unresolvedReference": {
            "strikethrough": true
        },
        "*.constant": {
            "bold": true
        },
        "keyword.constant": {
            "bold": false
        },
        "variable.constant": {
            //
        },
        "variable.mutable": {
            "underline": false,
        },
        "selfKeyword.mutable": {
            "underline": false,
        },
        "selfParameter.mutable": {
            "underline": false,
        },
        "method.mutable": {
            "underline": true,
        },
        "function.mutable": {
            "underline": true,
        },
        "*.attribute": {
            "foreground": "#ffffff88"
        },
        "attributeBracket": {
            //
        },
        "derive": {
            "foreground": "#c2e5fbb8"
        },
        "decorator": {
            "foreground": "#ffffffb8"
        },
        "*.deprecated": {
            "strikethrough": true
        },
        "brace": {
            "foreground": "#57575a"
        },
        "tomlTableKey": {
            "foreground": "#ff8787"
        },
        "tomlArrayKey": {
            "foreground": "#ff8787"
        },
