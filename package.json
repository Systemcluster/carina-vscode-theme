{
  "name": "theme-carinae",
  "displayName": "%displayName%",
  "description": "%description%",
  "publisher": "Systemcluster",
  "version": "0.1.0",
  "license": "BSD-2-Clause",
  "repository": "https://github.com/Systemcluster/carina-vscode-theme",
  "type": "module",
  "icon": "assets/logo.png",
  "categories": [
    "Themes"
  ],
  "engines": {
    "vscode": "*"
  },
  "contributes": {
    "themes": [
      {
        "id": "Carinae Light",
        "label": "%carinaLightColorThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/carina_light.json"
      },
      {
        "id": "Carinae Dark",
        "label": "%carinaDarkColorThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/carina_dark.json"
      }
    ]
  },
  "files": [
    "assets/*",
    "themes/*",
    "package.json",
    "package.nls.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vsce package"
  },
  "galleryBanner": {
    "color": "#121215",
    "theme": "dark"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
